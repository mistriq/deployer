# HTTP listen address. Defaults to 127.0.0.1:9090.
DEPLOYER_ADDR=127.0.0.1:9090

# SQLite database path. Defaults to deployer.db.
DEPLOYER_DB_PATH=deployer.db

# Optional public URL used in generated runner setup commands.
DEPLOYER_PUBLIC_URL=https://deployer.example.com

# Runtime storage and retention.
DEPLOYER_ARTIFACT_DIR=/tmp/deployer-artifacts
DEPLOYER_SNAPSHOT_DIR=/tmp/deployer-snapshots
DEPLOYER_ARTIFACT_RETENTION_HOURS=24
DEPLOYER_LOG_RETENTION_DAYS=30

# Hosting runtime namespaces are derived from the control-plane external project ID.
DEPLOYER_HOSTING_DEPLOY_ROOT=/srv/deployer/hosting/apps

# Authenticated exact-source broker. Use HTTPS except for loopback tests.
DEPLOYER_HOSTING_SOURCE_BROKER_URL=https://hosting-control.internal.example
DEPLOYER_HOSTING_SOURCE_BROKER_TOKEN=replace-with-source-broker-token
DEPLOYER_HOSTING_SOURCE_BROKER_TIMEOUT=4m
DEPLOYER_HOSTING_SOURCE_MAX_BYTES=536870912

# Private reverse-proxy adapter. Use HTTPS except for loopback development.
DEPLOYER_PROXY_ADAPTER_URL=https://proxy-adapter.internal.example
DEPLOYER_PROXY_ADAPTER_TOKEN=replace-with-private-adapter-token
DEPLOYER_PROXY_ADAPTER_TIMEOUT=15s

# Signed at-least-once terminal callbacks to the hosting control plane.
DEPLOYER_HOSTING_CALLBACK_URL=https://hosting-control.internal.example/callbacks/deployer
DEPLOYER_HOSTING_CALLBACK_SECRET=replace-with-at-least-32-random-bytes
DEPLOYER_HOSTING_CALLBACK_TIMEOUT=15s
DEPLOYER_HOSTING_CALLBACK_MAX_ATTEMPTS=12

# Service-token rotation and hosting record retention. Zero retention disables deletion.
DEPLOYER_SERVICE_TOKEN_ROTATION_OVERLAP=24h
DEPLOYER_HOSTING_LOG_RETENTION_DAYS=30
DEPLOYER_HOSTING_EVENT_RETENTION_DAYS=90
DEPLOYER_HOSTING_RELEASE_RETENTION_DAYS=90
DEPLOYER_HOSTING_CALLBACK_RETENTION_DAYS=30
DEPLOYER_HOSTING_AUDIT_RETENTION_DAYS=365

# Runtime timeouts use Go duration syntax.
DEPLOYER_SERVER_READ_TIMEOUT=30s
DEPLOYER_SERVER_WRITE_TIMEOUT=5m
DEPLOYER_DOCKER_BUILD_TIMEOUT=15m
DEPLOYER_SCP_TIMEOUT=10m
DEPLOYER_SSH_TIMEOUT=5m
DEPLOYER_HEALTH_CHECK_TIMEOUT=60s
DEPLOYER_AGENT_CONTROL_TIMEOUT=45s
DEPLOYER_AGENT_ARTIFACT_TIMEOUT=30m

# Dedicated hosting-agent settings.
DEPLOYER_SERVER=https://deployer.internal.example
DEPLOYER_TOKEN=replace-with-one-time-htr-token
DEPLOYER_HOSTING_AGENT_WORK_ROOT=/var/lib/deployer-hosting-agent
DEPLOYER_HOSTING_AGENT_RUNTIME_BIND_ADDRESS=127.0.0.1
DEPLOYER_HOSTING_AGENT_BUILD_NETWORK=hosting-build-egress
DEPLOYER_HOSTING_AGENT_BUILD_TIMEOUT=15m
DEPLOYER_HOSTING_AGENT_DRAINING=false

# Optional: seed public-safe demo records into an empty database.
DEPLOYER_DEMO_MODE=false

# Broad Docker prune is disabled by default.
DEPLOYER_DOCKER_PRUNE=false

# Runner agents default to checksum-verified manual updates.
DEPLOYER_AGENT_AUTO_UPDATE=false
