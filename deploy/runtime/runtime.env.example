# Runtime-only command. Copy outside the Git checkout and use private secret files.
DEPLOYER_LISTEN=127.0.0.1:8091
DEPLOYER_STATE_PATH=/var/lib/runtime-deployer/state.enc
DEPLOYER_STATE_KEY_FILE=/etc/runtime-deployer/state-key
PORTAL_TOKENS_FILE=/etc/runtime-deployer/portal-tokens.json
RUNTIME_BASE_URL=https://scr.socen.eu
RUNTIME_TOKEN_FILE=/etc/runtime-deployer/runtime-token
# Prototype only. Keep true for integration tests. Never change automatically.
RUNTIME_SANDBOX=true
REGISTRY_IMAGE_PREFIX=registry.example.com/runtime-apps
REGISTRY_PUSH_USERNAME=deployer-push
REGISTRY_PUSH_PASSWORD_FILE=/etc/runtime-deployer/registry-push-password
