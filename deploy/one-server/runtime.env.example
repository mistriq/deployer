DEPLOYER_LISTEN=127.0.0.1:8091
DEPLOYER_STATE_PATH=/var/lib/runtime-deployer/state.enc
DEPLOYER_STATE_KEY_FILE=/etc/runtime-deployer/state-key
PORTAL_TOKENS_FILE=/etc/runtime-deployer/production-organization-tokens.json
RUNTIME_TARGETS_FILE=/etc/runtime-deployer/production-targets.json
RUNTIME_SANDBOX=false
REGISTRY_IMAGE_PREFIX=registry.example.com/production-apps
REGISTRY_PUSH_USERNAME=production-deployer
REGISTRY_PUSH_PASSWORD_FILE=/etc/runtime-deployer/production-registry-password
